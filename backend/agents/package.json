    "test": "tsx --test test/*.test.ts",
    "test:loop": "tsx test/ollama-loop.live.ts"
  },
  "dependencies": {
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  }
}
