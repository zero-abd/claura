{
  "name": "claura-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Claura agent runner: NVIDIA Nemotron (local Ollama) drives Sentry/Triage/Warden/Scribe against the SpacetimeDB module",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "demo": "tsx src/main.ts",
    "demo:scripted": "tsx src/main.ts --scripted",
